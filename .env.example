# ─────────────────────────────────────────────────────────────
# Example environment file. Copy to .env and fill in real values:
#   cp .env.example .env
# The real .env is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# Higgsfield API credentials
# Higgsfield's REST API authenticates with two values sent as headers:
#   hf-api-key: <HIGGSFIELD_API_KEY>
#   hf-secret:  <HIGGSFIELD_API_SECRET>
HIGGSFIELD_API_KEY=your-higgsfield-api-key-here
HIGGSFIELD_API_SECRET=your-higgsfield-api-secret-here

# Optional: override the API base URL if needed
# HIGGSFIELD_API_URL=https://platform.higgsfield.ai
